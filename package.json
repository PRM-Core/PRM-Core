{
  "name": "prm-core",
  "description": "Open-source patient CRM and marketing automation for medical clinics.",
  "keywords": [
    "crm",
    "healthcare",
    "clinic",
    "patient-engagement",
    "marketing-automation",
    "gdpr",
    "sms",
    "email",
    "tanstack-start",
    "sqlite"
