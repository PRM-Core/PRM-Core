    "backup": "bun scripts/backup.mjs",
    "build:oss": "cp vite.config.oss.ts vite.config.ts && bun run build",
    "sprawdz:rozdzial": "bun run scripts/sprawdz-rozdzial.ts",
    "sprawdz:historia": "bun run scripts/sprawdz-rozdzial.ts --historia"
  },
