# PRM Core — zmienne środowiskowe.
#
# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium (jest w
# .gitignore) — na serwerze trzymaj go z prawami 600.
#
# Aplikacja uruchomi się bez żadnego z kluczy poniżej: silnik działa dalej i
# uczciwie odnotowuje, że nie miał czym wysłać. Brak klucza nigdy nie jest
# udawany jako sukces.

# ── HTTPS ───────────────────────────────────────────────────────────────────
# Odkomentuj, jeśli HTTPS ma obsługiwać Caddy dostarczony z tym projektem
# (zalecane, gdy na serwerze nie ma innego serwera WWW). Docker Compose czyta tę
# zmienną z .env, więc `./deploy.sh` uruchomi wtedy także kontener z Caddym.
# Zostaw zakomentowane, jeśli używasz własnego Caddy/nginx na hoście — wtedy
# aplikacja słucha tylko na 127.0.0.1:3000 i to on ma do niej kierować ruch.
COMPOSE_PROFILES=bundled-caddy

# ── Podstawy ────────────────────────────────────────────────────────────────

# Język domyślny instalacji: en (domyślnie) albo pl. Każdy użytkownik przełącza
# swój język w menu konta; ten tutaj dotyczy osób, które jeszcze nie wybrały,
# oraz pracy bez użytkownika: silnika automatyzacji, wiadomości i stron dla
# pacjentów, raportu bezpieczeństwa. Installation default language: en or pl.
PRM_LOCALE=en

PORT=3000
HOST=0.0.0.0

# Baza. W Dockerze wskazuje na wolumen hosta (./data), więc przetrwa każde
# wdrożenie. Lokalnie plik w katalogu repo.
DATABASE_URL=file:/data/prm-core.db

# Adres publiczny instalacji. WYMAGANY na produkcji: z niego budowane są
# piksele i linki trackingowe w wysyłanych wiadomościach oraz adresy webhooków.
# Dopóki wskazuje na localhost, otwarcia e-maili nie będą się rejestrować, bo
# klient pocztowy odbiorcy nie ma jak pobrać obrazka z Twojego localhosta.
APP_BASE_URL=https://crm.przyklad.pl

# Nazwa placówki wstawiana w treści generowane przez system: temat i stopka
# dobowego raportu bezpieczeństwa oraz prompty PRM_Agenta. Można zostawić puste
# — teksty powiedzą wtedy „placówka" bez nazwy.
PRM_ORG_NAME=

# ── Dobowy raport bezpieczeństwa ────────────────────────────────────────────
# Adres, na który PRM_Agent wysyła poranne podsumowanie logów i stanu
# zabezpieczeń. BEZ TEGO WPISU RAPORT SIĘ NIE WYSYŁA — celowo nie ma wartości
# domyślnej, żeby świeża instalacja nie wysłała raportu pod cudzy adres.
PRM_SECURITY_REPORT_TO=
# Godzina wysyłki (czas warszawski) i własny limit dobowy w USD na wywołania
# modelu. Puste = 7:00 i 5 USD.
PRM_SECURITY_REPORT_HOUR=
PRM_SECURITY_REPORT_LIMIT_USD=

# Host, na który wskazują rekordy CNAME domen własnych (Ustawienia → Domeny).
# Publiczna nazwa, nie sekret — dlatego przedrostek VITE_ (trafia do przeglądarki).
# Puste = ta instalacja nie obsługuje domen własnych, a ekran mówi to wprost.
VITE_PLATFORM_CNAME_TARGET=

# ── Pierwszy administrator (tylko przy `bun run db:seed`) ───────────────────
# Zostaw puste, a hasło zostanie wygenerowane i pokazane raz w konsoli.
PRM_ADMIN_EMAIL=
PRM_ADMIN_PASSWORD=

# ── Klucz szyfrujący danych dostępowych ────────────────────────────────────
# Klucze integracji (wszystko poniżej: SendGrid, Twilio, AI, Meta, Canva,
# system rezerwacji, MCP) najwygodniej ustawiać w panelu: Integracje → Klucze i dane
# dostępowe. Panel zapisuje je w bazie ZASZYFROWANE tym kluczem i ma
# pierwszeństwo przed wartościami z tego pliku. Bez PRM_SECRETS_KEY zapis
# z panelu jest wyłączony, a system czyta klucze tylko stąd.
#
# 64 znaki szesnastkowe:  head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
# (albo: openssl rand -hex 32 — jeśli openssl jest zainstalowany)
# Trzymaj kopię tego klucza OSOBNO od kopii bazy — to dzięki temu kopia bazy
# sama w sobie nie zdradza kluczy. Zgubiony klucz = wpisy z panelu trzeba
# wprowadzić ponownie (system w międzyczasie korzysta z wartości z tego pliku).
PRM_SECRETS_KEY=

# Zmienne poniżej są OPCJONALNE, jeśli klucze ustawiasz w panelu.

# ── SendGrid — wysyłka e-mail ───────────────────────────────────────────────
# Klucz z uprawnieniem "Mail Send": Settings → API Keys.
SENDGRID_API_KEY=

# ── Twilio — wysyłka i odbiór SMS ───────────────────────────────────────────
# UWAGA: potrzebny Account SID (zaczyna się od AC), a nie SID klucza API (SK).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Model AI (węzeł Agent AI, Copilot, sugestie w skrzynce) ─────────────────
# Wystarczy klucz tego dostawcy, którego wybierzesz w Ustawieniach → PRM_Agent.
# Domyślny jest Anthropic. Bez klucza silnik pomija wyłącznie kroki AI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Dane demonstracyjne ─────────────────────────────────────────────────────
# Na pustej bazie system potrafi zaseedować 8 przykładowych pacjentów,
# 6 automatyzacji i 3 lejki — przydatne przy pierwszym uruchomieniu lokalnie,
# szkodliwe na produkcji (fikcyjni pacjenci wchodzą do statystyk i do audytorium
# pierwszej kampanii). Domyślnie: seeduje się poza produkcją, na produkcji nie.
#   1 — seeduj mimo produkcji (instancja demo)
#   0 — nie seeduj nigdy
PRM_SEED_DEMO=0

# ── Weryfikacja SMS przy logowaniu (2FA) ────────────────────────────────────
# Po poprawnym haśle system wysyła sześciocyfrowy kod SMS-em (Twilio powyżej).
# Obowiązuje TYLKO konta, które mają uzupełniony numer telefonu — konto bez
# numeru loguje się samym hasłem. Numer ustawia się w menu konta albo
# w Ustawieniach → Użytkownicy.
#
# Ta flaga wyłącza weryfikację całkowicie, niezależnie od numerów. Dwa
# zastosowania:
#   • WDROŻENIE ETAPAMI — wgraj z `1`, rozdaj numery wszystkim kontom, potem
#     ustaw `0` i przeładuj kontener. Weryfikacja rusza dla wszystkich naraz.
#   • AWARIA — gdyby coś poszło nie tak z logowaniem, `1` przywraca stan
#     sprzed 2FA bez cofania wersji.
# Puste albo 0 = weryfikacja działa normalnie.
PRM_2FA_DISABLED=0

# System rezerwacji placówki — klucze dostawcy (pliki w
# src/lib/booking-system/providers/) wpisuje się w Integracje → Klucze albo tu,
# pod nazwami, które podaje dany dostawca. Produkt nie ma dostawcy wbudowanego.
#
# UWAGA na znak `$` w hasłach — ten plik czyta **docker compose**, a on
# traktuje `$ab` jako odwołanie do zmiennej. Escape dla Compose to podwojony
# dolar: `abc$def` zapisz jako `abc$$def`. Po zmianie pliku potrzebne jest
# `docker compose up -d` (sam `restart` zachowuje stare środowisko).

# ── Meta Lead Ads — leady z reklam Facebooka i Instagrama ───────────────────
# developers.facebook.com → aplikacja → Ustawienia → Podstawowe. Token
# weryfikacji to dowolny ciąg wpisany tu i w ustawieniach webhooka aplikacji.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ── Canva — projekty do Studia ──────────────────────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ── MCP — dostęp asystentów AI ──────────────────────────────────────────────
# Puste = wyłączone (adresy /mcp odpowiadają 404). W panelu da się token
# wygenerować jednym kliknięciem.
PRM_MCP_TOKEN=

# ── Informacje o aktualizacjach ─────────────────────────────────────────────
# Raz na 12 godzin serwer pobiera publiczny plik updates.json z repozytorium
# PRM Core i pokazuje administratorom nową wersję oraz ważne komunikaty
# (np. poprawki bezpieczeństwa). Nic nie jest wysyłane: żadnej wersji,
# identyfikatora ani danych. 0 = wyłączone (żadnego połączenia).
PRM_UPDATE_CHECK=1
# Własny plik (np. fork albo dystrybucja Enterprise). Tylko https://.
PRM_UPDATE_FEED_URL=
